{
  "name": "lego-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Google Apps Script project for managing Lego collection",
  "scripts": {
    "login": "clasp login",
    "whoami": "clasp show-authorized-user",
    "pull": "clasp pull",
    "push": "clasp push",
    "watch": "clasp push --watch",
    "status": "clasp show-file-status",
    "open": "clasp open-script",
    "logs": "clasp tail-logs",
    "deploy": "node scripts/deploy.js",
    "deploy:url": "node scripts/deploy.js --url",
    "deploy:new": "clasp create-deployment",
    "deployments": "clasp list-deployments"
  },
  "devDependencies": {
    "@google/clasp": "^3.3.0",
    "@types/google-apps-script": "^1.0.98"
  }
}
